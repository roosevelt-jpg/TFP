# Public base URL of the app (used for canonical URLs, OG images, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Release toggle: set to true when billing goes live to surface the membership
# support flows (billing, pause, cancel, refund). Defaults to false (waitlist).
PAYMENTS_LIVE="false"

# Postgres. Local dev = Docker (docker compose up): both point at localhost:15432.
# (55433 is often blocked by Windows Hyper-V excluded port ranges.)
#
# Production (Supabase):
#   DATABASE_URL = the Supavisor POOLED connection (transaction mode, port 6543).
#     Transaction-mode pooling shares connections, which breaks prepared
#     statements — so this URL MUST disable them: append `?pgbouncer=true`
#     (and the adapter-pg pool must be configured accordingly). Do this when
#     wiring Supabase; local Docker (direct connection) is unaffected.
#   DIRECT_URL   = the DIRECT connection (port 5432). Used by migrations only.
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/formula"
DIRECT_URL="postgresql://postgres:postgres@localhost:15432/formula"

# Max Postgres connections per serverless instance (default 1). Keep low in
# prod: Supavisor pools for us, so each Vercel instance needs very few. Raise
# only if a single request runs several parallel queries (ours doesn't).
DB_POOL_MAX="1"

# Multi-driver mail:
# - Admin invites / staff welcome → Gmail SMTP preferred, Resend fallback
# - Client emails (waitlist, purchase, trial, launch, support) → Resend preferred,
#   Gmail SMTP fallback
# Configure at least one driver. Kane can also set these under /admin/integrations.
#
# Resend. RESEND_FROM must be a verified sender on the domain,
# e.g. "The Formula Programme <hello@theformulaperformance.com>".
# In prod, set these in Vercel; the Trigger.dev Vercel integration syncs them
# into the Trigger environment automatically (no manual dual-entry).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="The Formula Programme <hello@theformulaperformance.com>"

# Gmail SMTP (App Password) — preferred for TFP Command admin invites.
# Use a Google Workspace / Gmail account with 2FA + App Password.
GMAIL_SMTP_USER="kane@theformulaperformance.com"
GMAIL_SMTP_PASS="xxxx xxxx xxxx xxxx"
GMAIL_SMTP_FROM="TFP Command <kane@theformulaperformance.com>"

# Performance logo is NOT a URL. Upload a black PNG via
# /admin/integrations → Email branding (stored in Blob, embedded as CID in every email).
# Local fallback file: public/email/logo.png
#
# Community image for waitlist email (still hosted on the site domain).
EMAIL_COMMUNITY_URL="https://train.theformulaperformance.com/email/community.jpg"

# Trigger.dev secret key — the Next server needs this to ENQUEUE tasks from the
# join action (the `trigger dev` worker authenticates separately via the CLI, so
# it does NOT supply this to the app). Use the dev key (tr_dev_...) locally.
# In prod the Vercel integration injects the prod key into Vercel for you, so you
# do NOT set it in Vercel by hand.
TRIGGER_SECRET_KEY="tr_dev_xxxxxxxxxxxxxxxxxxxxxxxx"

# Upstash Redis — rate limits the public forms. Required (set both in Vercel
# prod too). A runtime Redis blip fails open; only the config is mandatory.
UPSTASH_REDIS_REST_URL="https://xxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxx"

# Sentry error tracking. DSN is public (Sentry no-ops without it). The others
# are build-only for source-map upload: ORG/PROJECT slugs + a SECRET org auth
# token (set the token in Vercel + CI as a secret; the rest as normal vars).
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oXXXX.ingest.de.sentry.io/XXXX"
SENTRY_ORG="the-formula-programme"
SENTRY_PROJECT="the-formula-programme-marketing"
SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxx"

# PostHog EU — product analytics + session replay. Key is public (project
# settings on eu.posthog.com); HOST is our managed reverse proxy (fall back to
# https://eu.i.posthog.com until the CNAME is live). Both optional: leave unset
# locally/CI and analytics no-ops. Build-time inlined — set BOTH in Vercel
# prod + preview, then redeploy. Session replay also needs the project toggle.
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://hub.theformulaperformance.com"

# Meta Pixel — ad conversion tracking (Lead on signup). ID is public (Meta
# Events Manager -> the pixel's ID). Optional: unset means the pixel never
# loads and its CSP origins are omitted. Build-time inlined — set in Vercel
# prod + preview, then redeploy. Consent-gated like PostHog.
NEXT_PUBLIC_META_PIXEL_ID="000000000000000"

# Cloudflare Turnstile — bot protection on the public forms. Site key is public,
# secret is server-only (both required; set in Vercel prod too). Cloudflare's
# always-pass test keys work in CI/dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# Stripe — payments. Use a RESTRICTED key (rk_test_…), not a secret key: least
# privilege means a leak can't do much. Needs write on Checkout Sessions,
# Customers, Subscriptions, Products, Prices, Coupons/Promotion Codes and Billing
# Portal Sessions; read on Invoices, Charges and Events.
# Hosted Checkout is a top-level redirect, so there is NO publishable key and no
# CSP change — embedded Stripe.js would need both.
# Read inside Trigger tasks too; the Trigger Vercel integration syncs it from
# Vercel automatically (same as RESEND_*).
STRIPE_SECRET_KEY="rk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Webhook signing secret. `pnpm dev` runs the listener for you (the `stripe`
# pane) against the `formula` CLI profile — set one up with
#   stripe login --project-name=formula
# The secret it prints is stable across restarts, so this value keeps working.
# Without the CLI that one pane fails and Next/Trigger carry on.
# In prod this belongs to the Dashboard endpoint instead.
# A wrong value means every event fails verification — the daily reconcile is
# what backfills state once it's fixed.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# GoHighLevel (LeadConnector) — sync waitlist signups into Contacts (both
# required; set in Vercel + Trigger prod). Token is a Sub-Account Private
# Integration token with contacts.read/write + customFields.read scopes.
# Location ID is the Sub-Account ID (from the dashboard URL). The runtime only
# needs read/write CONTACTS; customFields.write is used once to create fields
# and can be removed after.
GHL_INTEGRATION_TOKEN="pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
GHL_LOCATION_ID="xxxxxxxxxxxxxxxxxxxx"
# Kill switch (defaults to true when unset): set "false" in Vercel + redeploy
# to stop enqueuing CRM syncs during a GHL incident — emails keep flowing and
# the skipped syncs are replayed later with `pnpm redrive --only ghl`.
# GHL_SYNC_ENABLED="false"

# Abandoned checkout recovery emails/tasks (30m / 6h / 24h / 48h).
# Keep "false" until smoke-tested in staging (Trigger + Resend). Go-live:
# 1) Deploy trigger tasks including checkout-recovery-step
# 2) Expire a test Checkout Session and confirm day-0 email after 30m
# 3) Confirm purchase cancels further recovery steps
# 4) Set CHECKOUT_RECOVERY_ENABLED=true in Vercel + Trigger, then redeploy
CHECKOUT_RECOVERY_ENABLED="true"
# Funnel channel flags — on by default; require Integrations credentials to actually send
FUNNEL_V2_ENABLED="true"
LEAD_NURTURE_ENABLED="true"
WHATSAPP_WORKFLOWS_ENABLED="true"
# First-party purchase confirmation + activation (default true in env.ts)
# WHATSAPP_SEND_PURCHASE_ACTIVATION="true"
# Cloud API credentials (also editable in /admin/integrations)
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Template names: prefer Admin → Growth → WhatsApp. Env below is fallback only.
# WHATSAPP_TEMPLATE_WAITLIST_WELCOME="waitlist_welcome"
# WHATSAPP_TEMPLATE_CHECKOUT_RECOVERY="checkout_recovery"
# WHATSAPP_TEMPLATE_PURCHASE_CONFIRMATION="purchase_confirmation"
# WHATSAPP_TEMPLATE_PURCHASE_ACTIVATION="purchase_activation"
# WHATSAPP_TEMPLATE_ACTIVATION_REMINDER="activation_reminder"
# WHATSAPP_TEMPLATE_SERVICE_REGISTERED="service_registered"
TELEGRAM_ACTIVATION_ENABLED="true"
INSTAGRAM_INBOUND_ENABLED="true"
COMPLETE_STACK_ENABLED="true"

