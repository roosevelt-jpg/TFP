# Vercel Blob, private store. Holds the master programme PDF and one
# watermarked copy per purchase. Created with:
#   vercel blob create-store <name> --access private
FORMULA_BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# TFP Command (/admin) — Better Auth secret (min 32 chars). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-change-me-to-a-long-random-secret!!"

