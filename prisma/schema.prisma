generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Goal {
  lose
  build
  fit
  focus
  general
}

enum Level {
  beg
  int
  adv
}

enum Sex {
  male
  female
  other
}

enum Diet {
  none
  vegetarian
  vegan
  pescatarian
  halal
  other
}

// Payments. Stripe is the system of record; these tables are a derived read
// model that converges via webhooks plus a daily reconcile, so every write is an
// idempotent upsert on a unique Stripe id. Timestamptz here; Waitlist predates
// that and converting it belongs in its own migration.

enum PurchaseStatus {
  pending
  paid
  failed
  refunded
}

// Every value Stripe can send, so a Dashboard-initiated pause or uncollectible
// invoice can't poison the event stream with an un-writable status.
enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

// `received` and `failed` are the states Stripe's retry (or the reconcile
// sweeper) must pick up again — never ack-and-drop them.
enum StripeEventStatus {
  received
  enqueued
  processed
  skipped
  failed
}

// Created by the webhook once payment lands, never before. Name, email and
// WhatsApp ride in the Checkout Session's metadata, which is enough to charge
// someone and reach them; everything else is asked after they've paid.
model Customer {
  id String @id @default(cuid())

  // Both unique: the WhatsApp bot identifies an inbound message by number alone,
  // and GHL's upsert matches on email OR phone.
  email            String @unique
  name             String
  whatsapp         String @unique
  stripeCustomerId String @unique

  // Recorded per purchase as consent proof, carried through session metadata.
  consentAt     DateTime @default(now()) @db.Timestamptz
  consentText   String
  policyVersion String

  // Set when the buyer came from a waitlist link; null for organic buyers.
  waitlistId String?
  waitlist   Waitlist? @relation(fields: [waitlistId], references: [id], onDelete: SetNull)

  coaching      CoachingProfile?
  purchases     Purchase[]
  subscriptions Subscription[]
  /// Linked warehouse CRM person (1:1 when resolved).
  person        PersonCustomer?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // @unique on email and whatsapp already provides their indexes.
  @@index([waitlistId])
}

// The coaching questions, asked AFTER payment. A paying customer has no row
// here until they complete onboarding, which is why every field is optional and
// why nothing in fulfillment depends on it.
model CoachingProfile {
  id String @id @default(cuid())

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  goal         Goal?
  level        Level?
  sex          Sex?
  age          Int?
  heightCm     Int?
  weightKg     Int?
  goalWeightKg Int?
  diet         Diet?
  injuries     String?

  completedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Purchase {
  id  String @id @default(cuid())
  ref String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  stripeCheckoutSessionId String @unique

  // dahlia severed charge.invoice, invoice.charge and payment_intent.invoice,
  // so the payment intent shared by the charge and the first invoice is the
  // only thing a refund can match a purchase on.
  stripeInvoiceId       String?
  stripePaymentIntentId String? @unique

  amountTotal   Int
  discountTotal Int     @default(0)
  currency      String
  promoCode     String?

  status PurchaseStatus @default(pending)

  pdfToken String @unique

  // Step ledger: each child task check-and-sets its own column, so a replay
  // whose Trigger idempotency key has expired still can't double-send. This,
  // not the queue key, is the real exactly-once guarantee.
  welcomeEmailAt DateTime? @db.Timestamptz
  pdfReadyAt     DateTime? @db.Timestamptz
  ghlSyncedAt    DateTime? @db.Timestamptz
  capiSentAt     DateTime? @db.Timestamptz

  purchasedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([customerId])
  @@index([status, createdAt])
}

model Subscription {
  id                   String @id @default(cuid())
  stripeSubscriptionId String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Always the programme price. PRO/ELITE live in the same Stripe account and
  // their events do reach our endpoint (Stripe filters webhooks by event type
  // only), so the router resolves the price and exits before any write.
  stripePriceId String

  status SubscriptionStatus

  cancelAtPeriodEnd  Boolean   @default(false)
  currentPeriodStart DateTime? @db.Timestamptz
  currentPeriodEnd   DateTime? @db.Timestamptz
  trialEnd           DateTime? @db.Timestamptz
  canceledAt         DateTime? @db.Timestamptz

  // Write fence: `created` of the newest event already applied. Concurrent
  // deliveries can fetch canonical state then race on the write, so an older
  // event is a no-op — otherwise a stale past_due lands after a terminal cancel.
  lastStripeEventCreated Int @default(0)

  // Claimed before the heads-up is sent. Stripe can deliver trial_will_end more
  // than once, and telling someone twice that they are about to be charged
  // reads as a billing fault.
  trialEndingEmailAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([customerId])
  @@index([status])
}

// Every signature-verified event, stored before any side effect runs. The event
// id as primary key makes duplicate delivery a PK conflict rather than a race.
// Payloads are pruned after 90 days; the envelope stays as an audit trail.
model StripeEvent {
  id        String            @id
  type      String
  livemode  Boolean
  payload   Json?
  status    StripeEventStatus @default(received)
  attempts  Int               @default(0)
  lastError String?

  receivedAt  DateTime  @default(now()) @db.Timestamptz
  processedAt DateTime? @db.Timestamptz

  // Redrive and the reconcile sweeper scan by status, newest first. A partial
  // index would be smaller, but Prisma can't express one and migrations stay
  // Prisma-generated, so this composite covers the same queries.
  @@index([status, receivedAt])
  @@index([type, receivedAt])
}

model Waitlist {
  id String @id @default(cuid())

  customers Customer[]

  // ref: human display code. publicToken: unguessable key used in the /joined
  // URL (never expose the primary key there).
  ref         String @unique
  publicToken String @unique

  email        String  @unique
  name         String
  whatsapp     String
  goal         Goal?
  level        Level?
  sex          Sex?
  age          Int?
  heightCm     Int?
  weightKg     Int?
  goalWeightKg Int?
  diet         Diet?
  injuries     String?

  consentAt     DateTime @default(now())
  consentText   String
  policyVersion String
  consentIp     String?

  // Claimed before the launch announcement is sent, so a re-run of the blast
  // skips anyone already told rather than mailing the list twice.
  launchEmailAt DateTime? @db.Timestamptz

  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  utmTerm               String?
  fbclid                String?
  gclid                 String?
  referrer              String?
  landingPath           String?
  // When the first-touch attribution (incl. fbclid) was captured client-side —
  // required to reconstruct Meta's _fbc for the Conversions API.
  attributionCapturedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// =============================================================================
// TFP Command — warehouse, auth, CMS (Roosevelt build pack Part 01 §4)
// Admin UI lives at /admin. Marketing landing stays on / and is CMS-driven.
// =============================================================================

enum StaffRole {
  kane
  leah
  lemoni
  indigo
  asim
  viewer
}

enum DataLabel {
  verified
  recorded
  calculated
}

enum BusinessLine {
  supplements
  coaching
  training
  shared
}

enum AlertSeverity {
  p1
  p2
  p3
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

enum ApprovalStatus {
  pending
  approved
  rejected
  executed
  expired
  voided
}

enum ConnectorStatus {
  idle
  running
  healthy
  stale
  error
  pending_audit
  phased
}

enum ContentAssetState {
  uploaded
  tagged
  editing
  review
  compliance
  awaiting_kane
  scheduled
  posted
  archived
  rejected
}

enum ProgrammeLine {
  coaching
  training
}

enum EnrolmentStatus {
  active
  paused
  completed
  cancelled
  pending_onboarding
}

enum LeadChannel {
  instagram
  whatsapp
  email
  other
}

enum CallOutcome {
  booked
  held
  no_show
  closed
  cancelled
  rescheduled
}

enum PaymentDueStatus {
  due
  awaiting_kane
  paid
  cancelled
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz
  role             StaffRole @default(viewer)
  twoFactorEnabled Boolean   @default(false)

  sessions     Session[]
  accounts     Account[]
  twoFactor    TwoFactor?
  staffProfile StaffProfile?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz

  @@map("twoFactor")
}

model CmsDocument {
  id        String   @id @default(cuid())
  namespace String
  key       String
  value     String
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([namespace, key])
  @@index([namespace])
}

model PersonCustomer {
  id         String  @id @default(cuid())
  email      String  @unique
  phone      String?
  name       String?
  shopifyId  String? @unique
  stripeId   String? @unique
  ghlId      String? @unique
  igHandle   String?

  /// Programme buyer identity when email/phone/Stripe match.
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Profile photo (data URL or /uploads/clients/… path).
  image       String?
  country     String?
  timezone    String?
  dateOfBirth DateTime? @db.Date
  bioSummary  String?

  orders       WarehouseOrder[]
  payments     WarehousePayment[]
  enrolments   ProgrammeEnrolment[]
  calls        Call[]
  leadThreads  LeadThread[]
  fulfilments  Fulfilment[]
  assignments  ClientStaffAssignment[]
  sessions     ClientSession[]
  notes        ClientNote[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([phone])
}

model WarehouseOrder {
  id             String       @id @default(cuid())
  shopifyOrderId String       @unique
  personId       String?
  person         PersonCustomer? @relation(fields: [personId], references: [id], onDelete: SetNull)
  businessLine   BusinessLine @default(supplements)
  orderName      String?
  grossPence     Int
  discountPence  Int          @default(0)
  netPence       Int
  cogsPence      Int          @default(0)
  shippingPence  Int          @default(0)
  refundedPence  Int          @default(0)
  isSubscription Boolean      @default(false)
  isStack        Boolean      @default(false)
  isNewCustomer  Boolean      @default(false)
  paidAt         DateTime?    @db.Timestamptz
  currency       String       @default("gbp")
  label          DataLabel    @default(verified)
  sourceFreshAt  DateTime?    @db.Timestamptz

  lines       OrderLine[]
  fulfilment  Fulfilment?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([paidAt])
  @@index([personId])
  @@index([businessLine, paidAt])
}

model OrderLine {
  id        String         @id @default(cuid())
  orderId   String
  order     WarehouseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       String
  title     String
  quantity  Int
  netPence  Int
  cogsPence Int            @default(0)

  @@index([orderId])
  @@index([sku])
}

model SubscriptionMirror {
  id               String   @id @default(cuid())
  contractId       String   @unique
  product          String
  interval         String
  status           String
  nextBillingAt    DateTime? @db.Timestamptz
  personEmail      String?
  label            DataLabel @default(recorded)
  sourceFreshAt    DateTime? @db.Timestamptz
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz
}

model ProgrammeEnrolment {
  id            String          @id @default(cuid())
  personId      String
  person        PersonCustomer  @relation(fields: [personId], references: [id], onDelete: Cascade)
  line          ProgrammeLine
  tier          String?
  pricePence    Int
  startDate     DateTime        @db.Timestamptz
  currentWeek   Int             @default(1)
  endDate       DateTime?       @db.Timestamptz
  status        EnrolmentStatus @default(active)
  paymentStatus String?
  label         DataLabel       @default(verified)
  sourceFreshAt DateTime?       @db.Timestamptz
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz

  @@index([personId])
  @@index([line, status])
}

model WarehousePayment {
  id              String          @id @default(cuid())
  stripeChargeId  String?         @unique
  personId        String?
  person          PersonCustomer? @relation(fields: [personId], references: [id], onDelete: SetNull)
  amountPence     Int
  currency        String          @default("gbp")
  productTier     String?
  businessLine    BusinessLine
  status          String
  disputeFlag     Boolean         @default(false)
  label           DataLabel       @default(verified)
  paidAt          DateTime?       @db.Timestamptz
  sourceFreshAt   DateTime?       @db.Timestamptz
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  @@index([personId])
  @@index([businessLine, paidAt])
}

model Call {
  id            String         @id @default(cuid())
  calendlyEventId String?      @unique
  personId      String?
  person        PersonCustomer? @relation(fields: [personId], references: [id], onDelete: SetNull)
  inviteeName   String?
  inviteeEmail  String?
  eventType     String?
  scheduledAt   DateTime       @db.Timestamptz
  outcome       CallOutcome    @default(booked)
  setter        String?
  cashCollectedPence Int       @default(0)
  label         DataLabel      @default(verified)
  sourceFreshAt DateTime?      @db.Timestamptz
  createdAt     DateTime       @default(now()) @db.Timestamptz
  updatedAt     DateTime       @updatedAt @db.Timestamptz

  @@index([scheduledAt])
  @@index([setter])
}

model LeadThread {
  id            String      @id @default(cuid())
  channel       LeadChannel
  externalId    String
  personId      String?
  person        PersonCustomer? @relation(fields: [personId], references: [id], onDelete: SetNull)
  contactName   String?
  snippet       String?
  intentScore   Int         @default(0)
  lastInboundAt DateTime?   @db.Timestamptz
  lastReplyAt   DateTime?   @db.Timestamptz
  highIntent    Boolean     @default(false)
  label         DataLabel   @default(verified)
  sourceFreshAt DateTime?   @db.Timestamptz
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz

  @@unique([channel, externalId])
  @@index([lastInboundAt])
}

model Affiliate {
  id              String   @id @default(cuid())
  name            String
  email           String?
  channel         String?
  agreementSigned Boolean  @default(false)
  lastPostLink    String?
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  codes AffiliateCode[]
}

model AffiliateCode {
  id           String    @id @default(cuid())
  affiliateId  String
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  code         String    @unique
  ordersCount  Int       @default(0)
  commissionPence Int    @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  @@index([affiliateId])
}

model StockItem {
  id              String    @id @default(cuid())
  sku             String    @unique
  title           String
  onHand          Int       @default(0)
  runRate7d       Float     @default(0)
  daysOfCover     Float?
  stackOrdersCover Float?
  label           DataLabel @default(verified)
  sourceFreshAt   DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
}

model Fulfilment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  order             WarehouseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  personId          String?
  person            PersonCustomer? @relation(fields: [personId], references: [id], onDelete: SetNull)
  paidAt            DateTime?      @db.Timestamptz
  fulfilledAt       DateTime?      @db.Timestamptz
  trackingComplete  Boolean        @default(false)
  componentGaps     Int            @default(0)
  hoursToDispatch   Float?
  carrier           String?
  region            String         @default("UK")
  label             DataLabel      @default(verified)
  sourceFreshAt     DateTime?      @db.Timestamptz
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz

  @@index([fulfilledAt])
  @@index([region])
}

model AdDaily {
  id                String    @id @default(cuid())
  date              DateTime  @db.Date
  campaignId        String?
  campaignName      String?
  adSetId           String
  adSetName         String
  adId              String?
  adName            String?
  spendPence        Int       @default(0)
  impressions       Int       @default(0)
  clicks            Int       @default(0)
  purchases7d       Int       @default(0)
  purchaseValue7dPence Int    @default(0)
  purchasesIncr     Int       @default(0)
  purchaseValueIncrPence Int  @default(0)
  ctr               Float?
  cpm               Float?
  frequency         Float?
  reviewStatus      String?
  label             DataLabel @default(verified)
  sourceFreshAt     DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  @@unique([date, adSetId, adId])
  @@index([date])
  @@index([adSetId, date])
}

model EmailDaily {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  name            String
  kind            String
  recipients      Int       @default(0)
  revenuePence    Int       @default(0)
  opens           Int       @default(0)
  clicks          Int       @default(0)
  bounceRate      Float?
  spamRate        Float?
  status          String?
  label           DataLabel @default(verified)
  sourceFreshAt   DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  @@index([date])
  @@index([name, date])
}

model FinanceTxn {
  id          String       @id @default(cuid())
  date        DateTime     @db.Date
  category    String
  subcategory String?
  description String
  amountPence Int
  currency    String       @default("gbp")
  account     String?
  businessLine BusinessLine @default(shared)
  rowNumber   Int?
  uploadBatch String?
  label       DataLabel    @default(recorded)
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  @@index([date])
  @@index([uploadBatch])
}

model PaymentDue {
  id          String           @id @default(cuid())
  payee       String
  amountPence Int
  currency    String           @default("gbp")
  dueDate     DateTime         @db.Date
  category    String
  status      PaymentDueStatus @default(due)
  isTeamPay   Boolean          @default(false)
  approvedBy  String?
  label       DataLabel        @default(recorded)
  createdAt   DateTime         @default(now()) @db.Timestamptz
  updatedAt   DateTime         @updatedAt @db.Timestamptz

  @@index([dueDate])
  @@index([status])
}

model Alert {
  id           String        @id @default(cuid())
  ruleId       String
  severity     AlertSeverity
  status       AlertStatus   @default(open)
  title        String
  payload      Json
  firedAt      DateTime      @default(now()) @db.Timestamptz
  acknowledgedAt DateTime?   @db.Timestamptz
  resolvedAt   DateTime?     @db.Timestamptz
  threadKey    String?
  telegramMsgId String?
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  @@index([status, severity])
  @@index([threadKey])
  @@index([ruleId, firedAt])
}

model ApprovalRequest {
  id                 String         @id @default(cuid())
  token              String         @unique
  action             String
  objectIds          Json
  beforeState        Json?
  afterState         Json?
  reach              String?
  reversible         Boolean        @default(true)
  specialistVerdict  String?
  status             ApprovalStatus @default(pending)
  approvedAt         DateTime?      @db.Timestamptz
  rejectedAt         DateTime?      @db.Timestamptz
  executedAt         DateTime?      @db.Timestamptz
  verificationResult String?
  expiresAt          DateTime       @db.Timestamptz
  payloadHash        String
  createdBy          String?
  createdAt          DateTime       @default(now()) @db.Timestamptz
  updatedAt          DateTime       @updatedAt @db.Timestamptz

  @@index([status, expiresAt])
}

