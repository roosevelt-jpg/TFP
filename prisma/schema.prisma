model ContentAsset {
  id             String            @id @default(cuid())
  hubAssetId     String?           @unique
  uploader       String
  tags           Json?
  creatorLicence Boolean           @default(false)
  state          ContentAssetState @default(uploaded)
  brief          String?
  filmingDay     DateTime?         @db.Date
  title          String
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  postCards PostCard[]
}

model PostCard {
  id               String            @id @default(cuid())
  assetId          String
  asset            ContentAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  platform         String
  account          String
  scheduledAt      DateTime?         @db.Timestamptz
  caption          String?
  coverUrl         String?
  complianceResult String?
  compliancePass   Boolean           @default(false)
  paidBoostFlag    Boolean           @default(false)
  approvalId       String?
  postUrl          String?
  status           ContentAssetState @default(awaiting_kane)
  createdAt        DateTime          @default(now()) @db.Timestamptz
  updatedAt        DateTime          @updatedAt @db.Timestamptz

  metrics PostMetric[]

  @@index([status, scheduledAt])
  @@index([assetId])
}

model PostMetric {
  id          String   @id @default(cuid())
  postCardId  String
  postCard    PostCard @relation(fields: [postCardId], references: [id], onDelete: Cascade)
  checkpoint  String
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  capturedAt  DateTime @default(now()) @db.Timestamptz

  @@unique([postCardId, checkpoint])
}

model Channel {
  id              String    @id @default(cuid())
  brand           String    @default("TFP")
  platform        String
  account         String
  tokenExpiresAt  DateTime? @db.Timestamptz
  publishingLimit Int?
  approvalMode    String    @default("every_post")
  paused          Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  @@unique([platform, account])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  meta       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@index([entityType, entityId])
}

model ConnectorRun {
  id           String          @id @default(cuid())
  sourceId     String
  name         String
  status       ConnectorStatus @default(idle)
  lastRunAt    DateTime?       @db.Timestamptz
  lastSuccessAt DateTime?      @db.Timestamptz
  lastError    String?
  scheduleNote String?
  writeGated   Boolean         @default(false)
  createdAt    DateTime        @default(now()) @db.Timestamptz
  updatedAt    DateTime        @updatedAt @db.Timestamptz

  @@unique([sourceId])
}

model AlertThreshold {
  id        String   @id @default(cuid())
  ruleId    String   @unique
  label     String
  value     Float
  unit      String?
  enabled   Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

/// Encrypted API credentials entered in /admin/integrations (Kane only).
/// Values never leave the server in plaintext after save.
model IntegrationSecret {
  id           String   @id @default(cuid())
  key          String   @unique
  ciphertext   String
  iv           String
  tag          String
  lastFour     String?
  updatedBy    String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz
}

enum StaffTodoStatus {
  open
  done
  skipped
}

enum StaffTodoSource {
  system
  kane
  self
}

enum StaffReportStatus {
  draft
  submitted
  approved
  rejected
}

/// Kane invite — email link creates Better Auth user with assigned role.
model StaffInvite {
  id         String    @id @default(cuid())
  email      String
  role       StaffRole
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime  @db.Timestamptz
  acceptedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  @@index([email])
  @@index([expiresAt])
}

/// Completed during invite accept — unlocks My Desk after Resend welcome.
model StaffProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  whatsapp    String?
  jobTitle    String
  timezone    String   @default("Asia/Dubai")
  completedAt DateTime @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
}

model StaffTodo {
  id             String          @id @default(cuid())
  personKey      String
  userId         String?
  title          String
  dueAt          DateTime?       @db.Timestamptz
  status         StaffTodoStatus @default(open)
  source         StaffTodoSource @default(system)
  linkedReportId String?
  createdBy      String?
  completedAt    DateTime?       @db.Timestamptz
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  @@index([personKey, status])
  @@index([userId, status])
  @@index([dueAt])
}

model StaffReport {
  id           String            @id @default(cuid())
  authorUserId String
  personKey    String
  periodLabel  String
  body         String
  status       StaffReportStatus @default(draft)
  submittedAt  DateTime?         @db.Timestamptz
  reviewedBy   String?
  reviewNote   String?
  reviewedAt   DateTime?         @db.Timestamptz
  createdAt    DateTime          @default(now()) @db.Timestamptz
  updatedAt    DateTime          @updatedAt @db.Timestamptz

  @@index([personKey, status])
  @@index([authorUserId, createdAt])
  @@index([status, submittedAt])
}

model DailySnapshot {
  id                String    @id @default(cuid())
  date              DateTime  @unique @db.Date
  revenuePence      Int       @default(0)
  adSpendPence      Int       @default(0)
  contributionPence Int       @default(0)
  cashBalancePence  Int?
  amer              Float?
  newLeads          Int       @default(0)
  label             DataLabel @default(calculated)
  payload           Json?
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz
}

model CashBalance {
  id          String    @id @default(cuid())
  account     String    @unique
  currency    String
  balanceMinor Int
  label       DataLabel @default(recorded)
  recordedAt  DateTime  @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
}

model TelegramMessageLog {
  id        String   @id @default(cuid())
  chatId    String
  direction String
  kind      String
  payload   Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([chatId, createdAt])
}

// --- Funnel CRM layer (spec §7): sits beside Customer/Waitlist, does not replace them ---

model ConsentRecord {
  id            String    @id @default(cuid())
  customerId    String?
  waitlistId    String?
  channel       String
  purpose       String
  status        String
  source        String
  policyVersion String
  capturedAt    DateTime  @db.Timestamptz
  withdrawnAt   DateTime? @db.Timestamptz
  ipAddress     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz

  @@index([customerId, channel, capturedAt])
  @@index([waitlistId, channel, capturedAt])
}

model FunnelEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique
  eventName     String
  customerId    String?
  waitlistId    String?
  anonymousId   String?
  sessionId     String?
  correlationId String?
  source        String
  properties    Json?
  occurredAt    DateTime @db.Timestamptz
  receivedAt    DateTime @default(now()) @db.Timestamptz

  @@index([eventName, occurredAt])
  @@index([customerId, occurredAt])
  @@index([waitlistId, occurredAt])
}

model WorkflowExecution {
  id             String    @id @default(cuid())
  dedupeKey      String    @unique
  workflowKey    String
  customerId     String?
  waitlistId     String?
  email          String?
  triggerEventId String?
  state          String    @default("running")
  currentStep    String?
  nextActionAt   DateTime? @db.Timestamptz
  attemptCount   Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  messages OutboundMessage[]

  @@index([workflowKey, state])
  @@index([nextActionAt])
  @@index([email])
}

model OutboundMessage {
  id                  String    @id @default(cuid())
  customerId          String?
  waitlistId          String?
  workflowExecutionId String?
  workflow            WorkflowExecution? @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)
  channel             String
  templateId          String?
  providerMessageId   String?
  status              String
  failureReason       String?
  createdAt           DateTime  @default(now()) @db.Timestamptz
  sentAt              DateTime? @db.Timestamptz

  @@index([workflowExecutionId])
  @@index([customerId, createdAt])
  @@index([waitlistId, createdAt])
}

model ChannelIdentity {
  id             String    @id @default(cuid())
  customerId     String?
  waitlistId     String?
  channel        String
  externalUserId String
  address        String?
  status         String    @default("active")
  lastInboundAt  DateTime? @db.Timestamptz
  lastOutboundAt DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  @@unique([channel, externalUserId])
  @@index([customerId])
  @@index([waitlistId])
}

// --- Client 360 CRM (admin-facing person profile) ---

enum ClientStaffRole {
  coach
  cs
  setter
  am
  fulfilment
}

enum ClientSessionType {
  coaching_call
  checkin
  assessment
  training
  onboarding
  other
}

enum ClientSessionStatus {
  scheduled
  completed
  no_show
  cancelled
}

model ClientStaffAssignment {
  id              String          @id @default(cuid())
  personId        String
  person          PersonCustomer  @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Scorecard key (leah / lemoni / indigo / asim) or free staff label.
  staffPersonKey  String
  staffUserId     String?
  role            ClientStaffRole @default(coach)
  assignedBy      String?
  assignedAt      DateTime        @default(now()) @db.Timestamptz
  endedAt         DateTime?       @db.Timestamptz
  notes           String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([personId, endedAt])
  @@index([staffPersonKey, endedAt])
}

model ClientSession {
  id             String              @id @default(cuid())
  personId       String
  person         PersonCustomer      @relation(fields: [personId], references: [id], onDelete: Cascade)
  customerId     String?
  type           ClientSessionType   @default(coaching_call)
  status         ClientSessionStatus @default(completed)
  title          String
  scheduledAt    DateTime            @db.Timestamptz
  completedAt    DateTime?           @db.Timestamptz
  durationMin    Int?
  staffPersonKey String?
  callId         String?
  notes          String?
  createdBy      String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([personId, scheduledAt])
  @@index([customerId, scheduledAt])
  @@index([status, scheduledAt])
}

model ClientNote {
  id         String         @id @default(cuid())
  personId   String
  person     PersonCustomer @relation(fields: [personId], references: [id], onDelete: Cascade)
  authorEmail String
  body       String
  pinned     Boolean        @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([personId, createdAt])
}

