{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/**/*.{ts,tsx}", "src/env.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": ["tailwindcss"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
