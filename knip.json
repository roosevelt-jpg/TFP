{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/env.ts",
    "src/lib/**/*.ts",
    "src/components/**/*.tsx",
    "src/content/**/*.ts",
    "src/hooks/**/*.ts",
    "src/trigger/**/*.{ts,tsx}",
    "trigger.config.ts",
    "scripts/**/*.{ts,mjs}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "shadcn",
    "@prisma/client",
    "@trigger.dev/build",
    "@react-email/ui"
  ],
  "ignoreBinaries": ["stripe"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
