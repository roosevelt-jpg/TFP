# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local AI / MCP config
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Local visual-diff screenshots (never commit)
scratchpad-*.png
.screenshots/

# Local planning/spec docs — never committed. Ignoring the contents rather than
# the directory itself, so the operational docs below can be un-ignored: git
# never descends into an excluded directory to reconsider a negation.
docs/*
# Read during an incident, so these ship with the code they describe rather
# than living on one laptop.
!docs/payments-runbook.md
!docs/go-live-checklist.md
!docs/manual-walkthrough.md
!docs/waitlist-deprecation.md
!docs/editor-knowledge-base.md
!docs/leah-daily-finance-template.csv

# prisma generated client (rebuilt via prisma generate / postinstall)
/src/generated/prisma/

# trigger.dev local build cache
.trigger
/lighthouse-report
/.lighthouseci
.local-assets/
